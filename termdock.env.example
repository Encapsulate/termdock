# Copy to ~/.config/termdock/termdock.env only for manual installations.
# The interactive installer writes this file and generates the password hash.
TERMDOCK_HOST="127.0.0.1"
TERMDOCK_PORT="8022"
TERMDOCK_TTYD_PORT="8023"
TERMDOCK_STATE_DIR="/home/YOU/.local/state/termdock"
TERMDOCK_WEB_USERNAME="change-me"
TERMDOCK_WEB_PASSWORD_HASH="generate-with-termdock-password"
TERMDOCK_SSH_HOST="127.0.0.1"
TERMDOCK_SSH_PORT="22"
TERMDOCK_SSH_USER="your-user"
TERMDOCK_SSH_IDENTITY_FILE="/home/YOU/.config/termdock/ssh/id_ed25519"
TERMDOCK_SSH_KNOWN_HOSTS_FILE="/home/YOU/.local/state/termdock/known_hosts"
TERMDOCK_SESSION_PREFIX="termdock"
TERMDOCK_TMUX_SOCKET="termdock"
TMUX_TMPDIR="/home/YOU/.local/state/termdock/tmux"
